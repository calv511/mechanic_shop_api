				{
					"name": "Create Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Response has an id\", function () {",
									"    pm.expect(pm.response.json()).to.have.property(\"id\");",
									"});",
									"pm.collectionVariables.set(\"customerId\", pm.response.json().id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Ada Lovelace\",\n    \"email\": \"ada@example.com\",\n    \"phone\": \"555-0100\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/customers/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"customers",
								""
							]
						},
						"description": "Creates a new customer. Returns 400 if the email is already associated with an account."
					}
				},
